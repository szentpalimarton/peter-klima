---
import Base from '../layouts/Base.astro';
import { BRAND, PHONE_DISPLAY, PHONE_TEL, PHONE_E164, EMAIL, AREA, AREAS_SERVED, withBase } from '../consts';

const title = 'Klímatisztítás Székesfehérváron és Fejér megyében | Péter';
const description =
  'Klímatisztítás és fertőtlenítés zsákos-átmosásos technikával Székesfehérváron és Fejér megyében. Friss levegő, kisebb fogyasztás, ár 15 000 Ft-tól.';

const homeUrl = withBase('/');
const pageUrl = new URL(withBase('/klimatisztitas/'), Astro.site).toString();

const faq = [
  {
    q: 'Miért büdös a klíma?',
    a: 'A kellemetlen szagot szinte mindig a beltéri egység nedves hőcserélőjén és csepptálcájában megtelepedő gombák és baktériumok okozzák. A hűtéskor lecsapódó pára ideális táptalajt ad nekik. Az alapos tisztítás és fertőtlenítés a szagot a forrásánál szünteti meg.',
  },
  {
    q: 'Mi történik, ha nem tisztíttatom a klímát?',
    a: 'A tisztítatlan klíma allergén szennyeződéseket, gomba- és baktériumspórákat fúj a szobába, ami hozzájárulhat a kellemetlen szaghoz és a légúti panaszokhoz. Ráadásul a koszos hőcserélővel nehezebben dolgozik, így többet is fogyaszt.',
  },
  {
    q: 'Mit jelent a zsákos-átmosásos tisztítás?',
    a: 'A beltéri egységet a helyszínen, egy felfogó zsák segítségével mossuk át: a hőcserélőről és a ventilátorról leoldott szennyeződést és vizet a zsák fogja fel, így a lakás tiszta és száraz marad a művelet közben.',
  },
  {
    q: 'Milyen gyakran kell klímát tisztíttatni?',
    a: 'Évente 1–2 alkalommal ajánlott: mindenképp a nyári hűtési szezon előtt, fűtésre optimalizált készüléknél pedig ősszel is. Allergiásoknál különösen fontos a rendszeres tisztítás.',
  },
  {
    q: 'Mennyibe kerül a klímatisztítás?',
    a: '1 beltéri egység 15 000 Ft, 2 egység 26 000 Ft, 3 egység 36 000 Ft, 4 egység 48 000 Ft. Ettől eltérő esetben egyedi ár — hívjon, és megbeszéljük.',
  },
  {
    q: 'Kapok számlát? Cégeknek is dolgoznak?',
    a: 'Igen, számlaképes szolgáltatás — a munkáról számlát adunk. Lakossági és céges ügyfeleket egyaránt kiszolgálunk.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Klímatisztítás és fertőtlenítés',
    name: 'Klímatisztítás Székesfehérváron és Fejér megyében',
    description:
      'Split klíma beltéri egységek mélytisztítása és fertőtlenítése zsákos-átmosásos technikával, lakossági és céges ügyfeleknek.',
    provider: {
      '@type': 'LocalBusiness',
      name: BRAND,
      telephone: PHONE_E164,
      email: EMAIL,
      url: Astro.site?.toString(),
    },
    areaServed: AREAS_SERVED,
    offers: {
      '@type': 'Offer',
      priceCurrency: 'HUF',
      price: 15000,
      description: '1 beltéri egység',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Főoldal', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: 'Klímatisztítás', item: pageUrl },
    ],
  },
];
---

<Base {title} {description} {schema}>
  <section class="page-hero">
    <div class="wrap">
      <nav class="breadcrumb"><a href={homeUrl}>Főoldal</a> › Klímatisztítás</nav>
      <span class="kicker">Fejér megye · Velencei-tó · Balaton · agglomeráció</span>
      <h1>Klímatisztítás és fertőtlenítés — friss, egészséges levegőért</h1>
      <p class="lead">
        A tisztítatlan klíma nemcsak büdös: allergén szennyeződéseket fúj a szobába, és
        többet is fogyaszt. Zsákos-átmosásos mélytisztítással és fertőtlenítéssel ezt oldjuk
        meg — a lakás tiszta marad. Előre kalkulálható ár, számlaképes szolgáltatás.
      </p>
      <div class="hero-cta">
        <a class="btn btn-call" href={PHONE_TEL} data-cta="call-klima-hero">📞 {PHONE_DISPLAY}</a>
        <a class="btn btn-ghost" href="#arak">Áraink</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>Miért fontos a klímatisztítás?</h2>
      <p>
        A klíma beltéri egysége hűtés közben párát csap ki, ezért a hőcserélője és a
        csepptálcája állandóan nedves — ez pedig ideális táptalaj a gombáknak és
        baktériumoknak. Ezeket a készülék visszafújja a szobába, és két dolgot okoz: romlik
        a levegő minősége, és nő a fogyasztás.
      </p>

      <div class="stat">
        <span class="big">A klíma nedves hőcserélőjén gomba és baktérium telepszik meg</span>
        <p>
          A lecsapódó pára miatt a hőcserélőn és a csepptálcában elszaporodó gombák és
          baktériumok a szobába jutnak, ami hozzájárulhat a kellemetlen szaghoz és a
          légúti-allergiás panaszokhoz — különösen érzékenyeknél és gyerekeknél. Az EPA
          szerint a beltéri levegő 2–5-ször (rossz szellőzésnél akár sokszorosan)
          szennyezettebb lehet a kültérinél.
        </p>
        <span class="src">Forrás: US EPA (beltéri levegőminőség)</span>
      </div>

      <div class="stat">
        <span class="big">A koszos klíma akár 5–15%-kal többet fogyaszt</span>
        <p>
          Az eltömődött szűrő és a szennyezett hőcserélő akadályozza a légáramlást, így a
          készülék nehezebben, több árammal dolgozik. Az amerikai Energiaügyi Minisztérium
          (DOE) szerint már a koszos szűrő tisztára cserélése is 5–15%-kal csökkentheti a
          klíma energiafogyasztását.
        </p>
        <span class="src">Forrás: US DOE (energy.gov)</span>
      </div>

      <p>
        A rendszeres tisztítás tehát nemcsak a friss, egészséges levegőt szolgálja, hanem a
        villanyszámlán is meglátszik — és a készülék élettartamát is óvja.
      </p>

      <h2>Hogyan tisztítunk?</h2>
      <p>
        Zsákos-átmosásos technikával dolgozunk, ami a helyszínen, tisztán elvégezhető
        mélytisztítást jelent:
      </p>
      <ul>
        <li><strong>Teljes mélytisztítás</strong>: hőcserélő, ventilátor, csepptálca — a lerakódott kosz eltávolítása.</li>
        <li><strong>Zsákos átmosás</strong>: a leoldott szennyeződést és vizet felfogó zsák gyűjti össze, így a lakás tiszta és száraz marad.</li>
        <li><strong>Fertőtlenítés</strong> a gombák, baktériumok és a kellemetlen szagok ellen — a forrásánál.</li>
        <li>Kondenzvíz-elvezetés ellenőrzése és próbaüzem, hogy minden rendben működjön.</li>
      </ul>
      <p>
        Olyan, a <strong>gyártó által ajánlott anyagokat</strong> használunk, amelyek
        kíméletesen oldják fel a szennyeződéseket — így a lerakódás biztosan leválik, a
        készülék alkatrészei pedig nem sérülnek.
      </p>

      <h2>Milyen gyakran érdemes?</h2>
      <p>
        Évente <strong>1–2 alkalom</strong> ajánlott: mindenképp a nyári hűtési szezon előtt,
        fűtésre optimalizált készüléknél pedig ősszel is. Allergiás
        háztartásban különösen fontos a rendszeres tisztítás.
      </p>
    </div>
  </section>

  <section class="section tint" id="arak">
    <div class="wrap">
      <span class="kicker">Árlista</span>
      <h2>Klímatisztítás árai</h2>
      <div class="price-grid">
        <div class="price-card">
          <h3>Klímatisztítás</h3>
          <table>
            <tbody>
              <tr><td>1 beltéri egység</td><td class="ar">15 000 Ft</td></tr>
              <tr><td>2 beltéri egység</td><td class="ar">26 000 Ft</td></tr>
              <tr><td>3 beltéri egység</td><td class="ar">36 000 Ft</td></tr>
              <tr><td>4 beltéri egység</td><td class="ar">48 000 Ft</td></tr>
            </tbody>
          </table>
          <p class="price-note">Ettől eltérő esetben egyedi ár — hívjon, és megbeszéljük.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="gyik">
    <div class="wrap">
      <span class="kicker">Gyakori kérdések</span>
      <h2>Klímatisztítás — gyakori kérdések</h2>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <a class="crosslink" href={withBase('/tudastar/miert-budos-a-klima/')}>
        <span class="k">Cikk</span>
        <strong>Miért büdös a klíma, és mit lehet tenni ellene?</strong><br />
        A szag oka és a tartós megoldás — miért nem elég a szagosító spray. <span class="arw">→</span>
      </a>
      <a class="crosslink" href={withBase('/tudastar/milyen-gyakran-kell-klimat-tisztittatni/')}>
        <span class="k">Cikk</span>
        <strong>Milyen gyakran kell klímát tisztíttatni?</strong><br />
        A legjobb időpontok és a jelek, hogy esedékes a tisztítás. <span class="arw">→</span>
      </a>

      <h2>Hol vállalunk klímatisztítást?</h2>
      <p>
        Fejér megye egész területén, a Balatonon és a budapesti agglomerációban —
        lakossági és céges ügyfeleknek egyaránt. A leggyakoribb helyszínek:
      </p>
      <ul class="area-links">
        <li><a href={withBase('/teruletek/gardony-velencei-to/')}>Gárdony, Velencei-tó</a></li>
        <li><a href={withBase('/teruletek/velence/')}>Velence</a></li>
        <li><a href={withBase('/teruletek/budaors/')}>Budaörs (irodák)</a></li>
        <li><a href={withBase('/teruletek/erd/')}>Érd</a></li>
        <li><a href={withBase('/teruletek/siofok/')}>Siófok</a></li>
        <li><a href={withBase('/teruletek/balatonfured/')}>Balatonfüred</a></li>
        <li><a href={withBase('/teruletek/tatabanya/')}>Tatabánya</a></li>
        <li><a href={withBase('/teruletek/veszprem/')}>Veszprém</a></li>
        <li><a href={withBase('/teruletek/')}>összes terület</a></li>
      </ul>

      <div class="cta-band">
        <h2>Kérjen időpontot</h2>
        <p>Mondja meg, hány beltéri egységről van szó, és máris egyeztetünk egy időpontot.</p>
        <a class="contact-phone" href={PHONE_TEL} data-cta="call-klima-cta">{PHONE_DISPLAY}</a><br />
        <a class="btn btn-call" href={PHONE_TEL} data-cta="call-klima-cta-btn">📞 Hívom most</a>
      </div>

      <div class="sources">
        <h2>Források</h2>
        <ol>
          <li>US Department of Energy — a klíma karbantartása és a szűrőcsere energiahatása: <a href="https://www.energy.gov/energysaver/maintaining-your-air-conditioner" rel="nofollow">Maintaining Your Air Conditioner, energy.gov</a>.</li>
          <li>US EPA — beltéri levegőminőség: <a href="https://www.epa.gov/indoor-air-quality-iaq" rel="nofollow">Indoor Air Quality (IAQ), epa.gov</a>.</li>
        </ol>
      </div>
    </div>
  </section>
</Base>
