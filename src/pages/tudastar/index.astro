---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../consts';

const title = 'Tudástár — napelem- és klímatisztítás | Péter';
const description =
  'Hasznos tudnivalók a napelem- és klímatisztításról: mennyivel termel többet a tiszta napelem, miért fontos a rendszeres tisztítás, gyakori kérdések.';

const homeUrl = withBase('/');

const articles = [
  {
    href: withBase('/tudastar/mennyivel-termel-tobbet-a-tiszta-napelem/'),
    title: 'Mennyivel termel többet a tiszta napelem?',
    excerpt:
      'Konkrét számok és források arról, mennyit veszít egy koszos panel — és egy forintos példa, hogy mikor térül meg a tisztítás.',
  },
  {
    href: withBase('/tudastar/miert-budos-a-klima/'),
    title: 'Miért büdös a klíma, és mit lehet tenni ellene?',
    excerpt:
      'A szagot a nedves hőcserélőn megtelepedő gomba és baktérium okozza. Így szüntethető meg tartósan — és így előzhető meg.',
  },
  {
    href: withBase('/tudastar/napelem-tisztitas-hazilag/'),
    title: 'Napelem tisztítás házilag: mikor szabad, és mikor veszélyes?',
    excerpt:
      'Mikor fér bele az otthoni öblítés, és mikor okoz kárt a tűző nap, a nagynyomású mosó vagy a mosószer — és mit csinál másképp a szakember.',
  },
  {
    href: withBase('/tudastar/milyen-gyakran-kell-klimat-tisztittatni/'),
    title: 'Milyen gyakran kell klímát tisztíttatni?',
    excerpt:
      'Évente 1–2 alkalommal — a hűtési szezon előtt, fűtésnél ősszel is. A legjobb időpontok és a jelek, hogy esedékes a tisztítás.',
  },
];
---

<Base {title} {description}>
  <section class="page-hero">
    <div class="wrap">
      <nav class="breadcrumb"><a href={homeUrl}>Főoldal</a> › Tudástár</nav>
      <span class="kicker">Tudástár</span>
      <h1>Tudástár</h1>
      <p class="lead">
        Hasznos, forrásokkal alátámasztott tudnivalók a napelem- és klímatisztításról —
        hogy tudja, mikor és miért érdemes tisztíttatni.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      {articles.map((a) => (
        <a class="crosslink" href={a.href}>
          <span class="k">Cikk</span>
          <strong>{a.title}</strong><br />
          {a.excerpt} <span class="arw">→</span>
        </a>
      ))}
    </div>
  </section>
</Base>
