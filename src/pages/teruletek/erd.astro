---
import Base from '../../layouts/Base.astro';
import { BRAND, PHONE_DISPLAY, PHONE_TEL, PHONE_E164, EMAIL, withBase } from '../../consts';

const title = 'Napelem- és klímatisztítás Érden | Péter';
const description =
  'Napelemtisztítás és klímatisztítás Érden, a Parkvárostól Ófaluig. Előre kalkulálható ár, számlaképes szolgáltatás, gyors időpont-egyeztetés. Hívjon!';

const homeUrl = withBase('/');
const teruletekUrl = withBase('/teruletek/');
const pageUrl = new URL(withBase('/teruletek/erd/'), Astro.site).toString();

const faq = [
  {
    q: 'Érd melyik részeire mennek ki?',
    a: 'Érd mind a kilenc városrészébe: Ófalu, Újfalu, Újtelep, Tusculanum, Érdliget, Györgyliget, Postástelep, Vincellér és Parkváros. A város nagy kiterjedésű, ezért időpont-egyeztetéskor érdemes megmondani a városrészt is, így tudjuk jól beosztani a napot.',
  },
  {
    q: 'Új építésű házunk van, kell egyáltalán tisztítani a napelemet?',
    a: 'Igen. A panel kora nem befolyásolja, hogy mennyi por, pollen és madárürülék rakódik rá. Egy vadonatúj rendszer is ugyanúgy veszít a termeléséből, ha koszos. Az első tisztítás jellemzően a beüzemelés utáni első-második évben esedékes, utána évente egyszer.',
  },
  {
    q: 'Domboldalon áll a ház, ez befolyásolja a munkát?',
    a: 'Az érdi tetőkön gyakori a lejtős telek és a többszintes beépítés. Ha a panelekhez állvány, emelőkosaras gép vagy más speciális hozzáférés kell, annak költségét külön számítjuk fel, de ezt előre, a telefonos egyeztetéskor tisztázzuk, nem a helyszínen derül ki.',
  },
  {
    q: 'Mennyibe kerül, és kapok számlát?',
    a: 'Napelemtisztítás 1–10 panelig 35 000 Ft, klímatisztítás 1 beltéri egység 15 000 Ft. A teljes árlista lent. Számlaképes szolgáltatás, lakossági és céges ügyfeleket egyaránt kiszolgálunk.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Napelemtisztítás és klímatisztítás',
    name: 'Napelem- és klímatisztítás Érden',
    description:
      'Kíméletes napelemtisztítás és zsákos-átmosásos klímatisztítás Érden és a budapesti agglomerációban.',
    provider: {
      '@type': 'LocalBusiness',
      name: BRAND,
      telephone: PHONE_E164,
      email: EMAIL,
      url: Astro.site?.toString(),
    },
    areaServed: [
      { '@type': 'City', name: 'Érd' },
      { '@type': 'City', name: 'Tárnok' },
      { '@type': 'City', name: 'Diósd' },
      { '@type': 'City', name: 'Százhalombatta' },
    ],
    offers: [
      { '@type': 'Offer', priceCurrency: 'HUF', price: 35000, description: 'Napelemtisztítás, 1–10 panel' },
      { '@type': 'Offer', priceCurrency: 'HUF', price: 15000, description: 'Klímatisztítás, 1 beltéri egység' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Főoldal', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: 'Területek', item: new URL(withBase('/teruletek/'), Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: 'Érd', item: pageUrl },
    ],
  },
];
---

<Base {title} {description} {schema}>
  <section class="page-hero">
    <div class="wrap">
      <nav class="breadcrumb"><a href={homeUrl}>Főoldal</a> › <a href={teruletekUrl}>Területek</a> › Érd</nav>
      <span class="kicker">Érd · budapesti agglomeráció</span>
      <h1>Napelem- és klímatisztítás Érden</h1>
      <p class="lead">
        Kíméletes napelemtisztítás szűrt, pH-semleges vízzel és klímatisztítás
        fertőtlenítéssel, Érd mind a kilenc városrészében. Előre kalkulálható ár,
        számlaképes szolgáltatás.
      </p>
      <div class="hero-cta">
        <a class="btn btn-call" href={PHONE_TEL} data-cta="call-erd-hero">📞 {PHONE_DISPLAY}</a>
        <a class="btn btn-ghost" href="#arak">Áraink</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>Egy város, ami folyamatosan épül</h2>
      <p>
        Érd <strong>közel 70 ezer lakosával</strong> az ország ötven legnépesebb
        települése közé tartozik, és <strong>lakosságszámban az egész országban itt nőtt
        a legtöbbet</strong> a népesség az elmúlt években. 2006 óta város, kilenc
        városrésszel: Ófalu, Újfalu, Újtelep, Tusculanum, Érdliget, Györgyliget,
        Postástelep, Vincellér és Parkváros.
      </p>
      <div class="stat solar">
        <span class="big">Sok új ház – és az új házakon szinte mindig van napelem</span>
        <p>
          A folyamatos beépülés azt jelenti, hogy Érden nagyon sok a <strong>friss, néhány
          éves családi ház</strong>, ahol a napelem és a split klíma ma már gyakorlatilag
          alapfelszerelés. Ezek a rendszerek most érnek abba a korba, amikor az első
          komolyabb szennyeződés összegyűlik a paneleken, sokan viszont még sosem
          tisztíttatták.
        </p>
      </div>
      <p>
        Fontos félreértés, hogy egy új rendszert nem kell tisztítani. A panel kora nem
        befolyásolja, mennyi por és pollen rakódik rá, csak az, mióta nem mosták le.
      </p>

      <h2>Lejtős telkek, dombra épült városrészek</h2>
      <p>
        Érd a Tétényi-fennsík peremén, dombos terepen fekszik (az Érdi-tető adja a város
        jellegzetes domborzatát). A gyakorlatban ez azt jelenti, hogy sok a lejtős telek
        és a többszintes beépítés, vagyis a tetőhöz való hozzáférés házanként nagyon
        eltérő lehet.
      </p>
      <p>
        Ezért kérünk mindig néhány részletet telefonon: hány panel, hányadik szint,
        milyen a megközelítés. Ha a munkához <strong>állvány vagy emelőkosaras gép</strong>
        kell, annak költségét külön számítjuk fel, de <strong>előre megmondjuk</strong>,
        nem a helyszínen derül ki.
      </p>

      <h2>M7 és a városi por</h2>
      <p>
        Az M7 autópálya átszeli a várost (Parkvárost is), a fővárosi agglomeráció
        forgalma pedig folyamatos. A közlekedésből származó por ugyanúgy lerakódik a
        tetőkön lévő paneleken, mint bárhol máshol, csak itt több belőle.
      </p>
      <a class="crosslink" href={withBase('/tudastar/mennyivel-termel-tobbet-a-tiszta-napelem/')}>
        <span class="k">Cikk</span>
        <strong>Mennyivel termel többet a tiszta napelem?</strong><br />
        Mérési adatok és forintos példa arról, mit visz el a rárakódott szennyeződés.
        <span class="arw">→</span>
      </a>
    </div>
  </section>

  <section class="section tint" id="arak">
    <div class="wrap">
      <span class="kicker">Árlista</span>
      <h2>Áraink Érden</h2>
      <div class="price-grid">
        <div class="price-card">
          <h3>Napelemtisztítás</h3>
          <table>
            <tbody>
              <tr><td>1–10 panel</td><td class="ar">35 000 Ft</td></tr>
              <tr><td>11–15 panel</td><td class="ar">50 000 Ft</td></tr>
              <tr><td>16–20 panel</td><td class="ar">65 000 Ft</td></tr>
              <tr><td>21–25 panel</td><td class="ar">80 000 Ft</td></tr>
            </tbody>
          </table>
          <p class="price-note">25 panel felett minden további 5 panel: +15 000 Ft.</p>
          <a class="more" href={withBase('/napelem-tisztitas/')}>Részletek a napelemtisztításról →</a>
        </div>
        <div class="price-card">
          <h3>Klímatisztítás</h3>
          <table>
            <tbody>
              <tr><td>1 beltéri egység</td><td class="ar">15 000 Ft</td></tr>
              <tr><td>2 beltéri egység</td><td class="ar">26 000 Ft</td></tr>
              <tr><td>3 beltéri egység</td><td class="ar">36 000 Ft</td></tr>
              <tr><td>4 beltéri egység</td><td class="ar">48 000 Ft</td></tr>
            </tbody>
          </table>
          <p class="price-note">Ettől eltérő esetben egyedi ár: hívjon, és megbeszéljük.</p>
          <a class="more" href={withBase('/klimatisztitas/')}>Részletek a klímatisztításról →</a>
        </div>
      </div>
      <p class="price-disclaimer">
        Az árak normál körülmények között érvényesek. Ha a munkavégzés állvány,
        emelőkosaras gép vagy más speciális hozzáférési megoldás használatát teszi
        szükségessé, annak költségét külön számítjuk fel. Ezt előre, az egyeztetéskor
        tisztázzuk. A szolgáltatás számlaképes, lakossági és céges ügyfeleknek egyaránt.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="kicker">Gyakori kérdések</span>
      <h2>Kérdések érdi ügyfelektől</h2>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap">
      <span class="kicker">Térkép</span>
      <h2>Érd és környéke</h2>
      <div class="map-embed">
        <iframe
          src="https://www.openstreetmap.org/export/embed.html?bbox=18.85%2C47.34%2C18.98%2C47.42&amp;layer=mapnik"
          title="Érd és környékének térképe"
          loading="lazy"
          referrerpolicy="no-referrer"
        ></iframe>
      </div>
      <p class="map-credit">
        Térkép: <a href="https://www.openstreetmap.org/copyright" rel="nofollow">© OpenStreetMap</a> közreműködők
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <div class="cta-band">
        <h2>Kérjen időpontot</h2>
        <p>Mondja meg a városrészt és hány panelről vagy klímáról van szó, mi mondjuk az árat.</p>
        <a class="contact-phone" href={PHONE_TEL} data-cta="call-erd-cta">{PHONE_DISPLAY}</a><br />
        <a class="btn btn-call" href={PHONE_TEL} data-cta="call-erd-cta-btn">📞 Hívom most</a>
      </div>

      <a class="crosslink" href={teruletekUrl}>
        <span class="k">Területek</span>
        <strong>Hol dolgozunk még?</strong><br />
        Budaörs, Biatorbágy, Martonvásár, Fejér megye, a Velencei-tó és a Balaton.
        <span class="arw">→</span>
      </a>
    </div>
  </section>
</Base>
