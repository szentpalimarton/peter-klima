---
import '../styles/global.css';
import { BRAND, PHONE_DISPLAY, PHONE_TEL, AREA_SHORT, UMAMI_WEBSITE_ID, withBase } from '../consts';

interface Props {
  title: string;
  description: string;
  /** JSON-LD objektumok, oldalanként */
  schema?: object[];
  /** Open Graph típus – a Tudástár cikkeknél "article" */
  ogType?: 'website' | 'article';
}

const { title, description, schema = [], ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase('/images/peter-kabala.jpg'), Astro.site);
// A github.io-s demót ne indexeljék a keresők – csak a végleges domain rangsorolhat.
const isDemo = import.meta.env.BASE_URL !== '/';
---

<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isDemo && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="hu_HU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {schema.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    {/* Cloudflare Web Analytics – sütimentes, anonim látogatottsági statisztika */}
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "8076197d25c144d49449e634f5f22bef"}'
    ></script>
    {/* CRO-07: sütimentes kattintás-mérés (Umami). Csak PROD-ban és csak akkor,
        ha a consts.ts-ben ki van töltve a website ID – addig semmi nem töltődik. */}
    {
      import.meta.env.PROD && UMAMI_WEBSITE_ID && (
        <>
          <script defer src="https://cloud.umami.is/script.js" data-website-id={UMAMI_WEBSITE_ID} />
          <script
            is:inline
            set:html={`document.addEventListener('click',function(e){var el=e.target&&e.target.closest&&e.target.closest('[data-cta]');if(el&&window.umami)window.umami.track('cta-'+el.getAttribute('data-cta'));},{passive:true});`}
          />
        </>
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={withBase('/')}>Péter<span class="dot"> ·</span> Napelem- és Klímatisztítás</a>
        <nav class="site-nav">
          <a href={withBase('/napelem-tisztitas/')}>Napelemtisztítás</a>
          <a href={withBase('/klimatisztitas/')}>Klímatisztítás</a>
          <a class="nav-wide" href={withBase('/arak/')}>Árak</a>
          <a href={withBase('/tudastar/')}>Tudástár</a>
          <a class="nav-wide" href={withBase('/teruletek/')}>Területek</a>
          <a class="nav-wide" href={withBase('/gyik/')}>GYIK</a>
        </nav>
        <a class="header-phone" href={PHONE_TEL} data-cta="call-header">📞 {PHONE_DISPLAY}</a>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap">
        <span>© 2026 {BRAND} – {AREA_SHORT}</span>
        <nav>
          <a href={withBase('/tudastar/')}>Tudástár</a>
          <a href={withBase('/teruletek/')}>Területek</a>
          <a href={withBase('/impresszum/')}>Impresszum</a>
          <a href={withBase('/adatkezeles/')}>Adatkezelés</a>
        </nav>
      </div>
    </footer>

    <div class="call-bar">
      <a class="btn btn-call" href={PHONE_TEL} data-cta="call-sticky">📞 Hívom: {PHONE_DISPLAY}</a>
    </div>
  </body>
</html>
